#!/usr/bin/env bash
set -euo pipefail
# AI Token Optimizer — Produce micro-context for a bug (Guide 2026 §19)

if [ "$#" -lt 1 ]; then
    echo "usage: ai-context 'regex' [path]"
    exit 1
fi

QUERY="$1"
SEARCH_PATH="${2:-.}"

echo "=== GIT STATUS ==="
git status --short 2>/dev/null | head -n 50 || true

echo ""
echo "=== MATCHES ==="
rg -n --hidden \
  --glob '!node_modules/**' --glob '!.git/**' --glob '!dist/**' \
  --glob '!build/**' --glob '!coverage/**' --glob '!vendor/**' \
  --glob '!.venv/**' --glob '!*.min.js' --glob '!*.map' \
  "$QUERY" "$SEARCH_PATH" | head -n 120 || true

echo ""
echo "=== CURRENT DIFF STAT ==="
git diff --stat 2>/dev/null || true
